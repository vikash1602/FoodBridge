# ---- Django core ----
# Generate a real secret for production:  python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Local dev default matches scripts in README. On Render/Railway use the Neon/Supabase URL.
DATABASE_URL=postgres://foodbridge:foodbridge@127.0.0.1:5432/foodbridge

# ---- CORS / frontend ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ---- SSE ----
# Max seconds an SSE connection stays open before the client reconnects (0 = no limit).
SSE_MAX_LIFETIME_SECONDS=300

# ---- OTP login ----
# DEBUG=True prints the code to the console and returns it in the API response.
# Production: set RESEND_API_KEY (Resend sandbox delivers only to the account
# owner until a sending domain is verified).
RESEND_API_KEY=
OTP_EMAIL_FROM=FoodBridge <onboarding@resend.dev>
OTP_EMAIL_FALLBACK_TO_CONSOLE=true

# ---- Cron endpoint secret (cron-job.org shared secret; never logged) ----
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The cron endpoints stay closed until a 32+ char secret is configured.
CRON_SECRET_KEY=

# ---- City (change these to deploy FoodBridge in any town) ----
DEFAULT_CITY_NAME=Vaniyambadi
DEFAULT_CENTER_LAT=12.6819
DEFAULT_CENTER_LNG=78.6200
DEFAULT_ZOOM=13
SERVICE_AREA_KM=25

# Escalation tiers "minutes:radius_km" comma separated, then the final radius.
ESCALATION_TIERS=20:3,40:6
ESCALATION_MAX_RADIUS_KM=12

# Location privacy fuzz radius for public listings (metres).
LOCATION_FUZZ_METRES=300

# ---- Media storage (S3-compatible) ----
# Development: leave unset → local media/ folder.
# Staging (Neon Object Storage): create a bucket + a storage credential in the
# Neon Console (Connect → Storage / Settings → Credentials), then set:
#   AWS_STORAGE_BUCKET_NAME=<bucket name>
#   AWS_ACCESS_KEY_ID=<token_id, nak_live_…>          (storage:write scope)
#   AWS_SECRET_ACCESS_KEY=<s3_secret_access_key, nsk_live_…>
#   AWS_S3_REGION_NAME=us-east-2
#   AWS_S3_ENDPOINT_URL=https://<branch-id>.storage.c-1.us-east-2.aws.neon.tech
# Path-style addressing is selected automatically when an endpoint URL is set
# (Neon does not support virtual-hosted style). Photos are served through
# short-lived presigned GET URLs from the private bucket; EXIF is stripped
# server-side before upload. AWS_S3_DEFAULT_ACL / AWS_S3_ADDRESSING_STYLE
# can override the defaults (empty ACL is sent to S3-compatible stores).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
